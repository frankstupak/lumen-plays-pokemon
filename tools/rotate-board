#!/usr/bin/env python3
"""wq#490 — rotate the LPP progress board when it grows past a threshold.

The board ($LPP_BOARD, outside the repo) is append-only and is how parallel agents
learn what each other is doing. It must stay SHORT enough that every agent
actually reads it at claim time — but nothing may be lost, so old lines are
moved to a dated archive, never deleted.

Policy:
  - header  = the leading comment block (lines starting with '#') is ALWAYS kept
  - if total lines > THRESHOLD (default 300): keep header + last KEEP (default
    50) entry lines; move everything between into
    $LPP_BOARD_ARCHIVE/QUEUE_PROGRESS-<YYYYMMDD-HHMMZ>.md
  - the archive file gets its own header pointing back at the live board, and
    the live board gets a one-line pointer to the archive appended at the top
    of the retained region so the trail is never broken.

Usage:
  tools/rotate-board            # rotate if over threshold
  tools/rotate-board --check    # report only, never write
  tools/rotate-board --force    # rotate regardless of threshold
  tools/rotate-board --keep 80 --threshold 400
"""
import argparse, os, sys
from datetime import datetime, timezone

# Board + archive live OUTSIDE the product repo (operations artifacts).
BOARD = os.environ.get(
    "LPP_BOARD", "/home/lumen/agents/work-queue/boards/LPP_QUEUE_PROGRESS.md")
ARCHIVE_DIR = os.environ.get(
    "LPP_BOARD_ARCHIVE", os.path.join(os.path.dirname(BOARD), "lpp-archive"))


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--threshold", type=int, default=300)
    ap.add_argument("--keep", type=int, default=50)
    ap.add_argument("--check", action="store_true", help="report only, never write")
    ap.add_argument("--force", action="store_true", help="rotate even if under threshold")
    a = ap.parse_args()

    if not os.path.exists(BOARD):
        print(f"no board at {BOARD}")
        return 1
    with open(BOARD, encoding="utf-8") as f:
        lines = f.read().splitlines()

    header, body = [], []
    for i, ln in enumerate(lines):
        if ln.startswith("#") and not body:
            header.append(ln)
        else:
            body = lines[i:]
            break

    total = len(lines)
    over = total > a.threshold
    print(f"board: {total} lines ({len(header)} header + {len(body)} entries), "
          f"threshold {a.threshold} -> {'OVER' if over else 'under'}")
    if a.check or (not over and not a.force):
        if not a.check:
            print("nothing to do")
        return 0
    if len(body) <= a.keep:
        print(f"only {len(body)} entries, keep={a.keep} — nothing to move")
        return 0

    move, keep = body[:-a.keep], body[-a.keep:]
    stamp = datetime.now(timezone.utc).strftime("%Y%m%d-%H%MZ")
    os.makedirs(ARCHIVE_DIR, exist_ok=True)
    dest = os.path.join(ARCHIVE_DIR, f"QUEUE_PROGRESS-{stamp}.md")
    with open(dest, "w", encoding="utf-8") as f:
        f.write(f"# LPP BOARD ARCHIVE — rotated {stamp}\n")
        f.write(f"# Older entries moved out of the live board to keep it readable.\n")
        f.write(f"# Nothing is ever deleted. Live board: {BOARD}\n")
        f.write("\n".join(move) + "\n")

    # atomic replace of the live board
    tmp = BOARD + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write("\n".join(header) + "\n")
        f.write(f"# (older entries archived -> {dest})\n")
        f.write("\n".join(keep) + "\n")
    os.replace(tmp, BOARD)
    print(f"moved {len(move)} entries -> {dest}; board now {len(keep)} entries")
    return 0


if __name__ == "__main__":
    sys.exit(main())
